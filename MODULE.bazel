bazel_dep(name = "rules_jvm_external", version = "6.8")
bazel_dep(name = "rules_java", version = "8.16.1")
bazel_dep(name = "rules_bazelrio", version = "0.0.14")
bazel_dep(name = "rules_pmd", version = "7.2.0.bcr1")
bazel_dep(name = "bzlmodrio-allwpilib", version = "2027.0.0-alpha-8")
bazel_dep(name = "bzlmodrio-opencv", version = "2027.4.13.0-4")
bazel_dep(name = "bzlmodrio-phoenix6", version = "26.70.0-alpha-2")
bazel_dep(name = "bzlmodrio-revlib", version = "2027.0.0-alpha-9")

# bzlmodrio-allwpilib 2027.0.0-alpha-8 references @bzlmodrio-opencv//libraries/cpp/opencv:shared,
# which no published bzlmodrio-opencv provides. Remove this once upstream is fixed.
single_version_override(
    module_name = "bzlmodrio-opencv",
    patch_strip = 1,
    patches = ["//build_scripts/bazel/patches:bzlmodrio-opencv-shared-alias.patch"],
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.junit.jupiter:junit-jupiter-api:5.13.4",
        "org.junit.jupiter:junit-jupiter-params:5.13.4",
        "org.junit.jupiter:junit-jupiter-engine:5.13.4",
        "org.junit.platform:junit-platform-commons:1.13.4",
        "org.junit.platform:junit-platform-console:1.13.4",
        "org.junit.platform:junit-platform-engine:1.13.4",
        "org.junit.platform:junit-platform-launcher:1.13.4",
        "org.junit.platform:junit-platform-suite-api:1.13.4",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://frcmaven.wpi.edu/release",
    ],
    lock_file = "//build_scripts/bazel/deps:maven_install.json",
)
use_repo(
    maven,
    "maven",
)
